<!DOCTYPE html>
<html lang="uk" class="h-full bg-zinc-100">
  <head>
    <title>Профіль-Системи | MVP</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Підключення інженерних шрифтів -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;700;800&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet">

    <style>
      body { font-family: 'Plus Jakarta Sans', sans-serif; }
      .font-mono-num { font-family: 'Space Grotesk', monospace; font-feature-settings: "tnum"; }
    </style>
  </head>

  <body class="min-h-full flex flex-col text-zinc-900 bg-zinc-100 antialiased">
    <header class="bg-white border-b-2 border-zinc-200 sticky top-0 z-50 shadow-sm">
      <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
        <%= link_to root_path, class: "flex items-center gap-2" do %>
          <div class="w-9 h-9 bg-zinc-900 text-white font-black flex items-center justify-center text-lg">ПС</div>
          <span class="font-extrabold uppercase tracking-tight text-sm sm:text-base">Профіль·Системи</span>
        <% end %>

        <nav class="flex items-center gap-3 text-xs font-bold uppercase tracking-wider">
          <%= link_to "Каталог", products_path, class: "px-3 py-2 hover:bg-zinc-100 rounded transition" %>
          <%= link_to "Калькулятор", configurator_path, class: "px-3 py-2 bg-amber-50 text-amber-800 border border-amber-300 rounded transition" %>
          <%= link_to "Замір", new_measurement_request_path, class: "px-3 py-2 border border-zinc-300 hover:bg-zinc-100 rounded transition" %>
          <%= link_to "Кошик", cart_items_path, class: "px-3 py-2 bg-zinc-900 text-white rounded transition" %>
        </nav>
      </div>
    </header>

    <div class="max-w-6xl mx-auto px-4 w-full mt-4">
      <% if notice.present? %>
        <div class="p-3 bg-emerald-50 border-l-4 border-emerald-600 text-emerald-900 text-xs font-semibold shadow-sm">
          <%= notice %>
        </div>
      <% end %>
      <% if alert.present? %>
        <div class="p-3 bg-rose-50 border-l-4 border-rose-600 text-rose-900 text-xs font-semibold shadow-sm">
          <%= alert %>
        </div>
      <% end %>
    </div>

    <main class="flex-1 max-w-6xl mx-auto px-4 py-6 w-full">
      <%= yield %>
    </main>

    <footer class="bg-zinc-900 text-zinc-400 py-6 text-center text-xs mt-auto border-t border-zinc-800">
      Профіль·Системи MVP — Лабораторна робота №6 (ІФНТУНГ, 2026)
    </footer>
  </body>
</html>