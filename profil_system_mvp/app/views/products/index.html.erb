<div class="space-y-6">
  <div class="flex justify-between items-end border-b-2 border-zinc-200 pb-3">
    <div>
      <span class="text-[11px] font-bold uppercase tracking-widest text-amber-600">Складські позиції</span>
      <h1 class="text-2xl font-black uppercase tracking-tight">Каталог вікон та дверей</h1>
    </div>
    <%= link_to "Калькулятор нестандартних розмірів →", configurator_path, class: "text-xs font-bold uppercase text-amber-700 hover:underline" %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
    <aside class="bg-white border-2 border-zinc-200 p-4 space-y-4 h-fit">
      <h2 class="text-xs font-bold uppercase tracking-wider border-b pb-2">Фільтрація</h2>
      <%= form_with url: products_path, method: :get, class: "space-y-3" do |f| %>
        <div>
          <%= f.label :category_id, "Категорія", class: "block text-[10px] font-bold uppercase text-zinc-500 mb-1" %>
          <%= f.select :category_id, options_from_collection_for_select(@categories, :id, :name, params[:category_id]), { include_blank: "Всі категорії" }, class: "w-full border-2 border-zinc-200 p-2 text-xs bg-white" %>
        </div>
        <div>
          <%= f.label :max_price, "Ціна до (грн)", class: "block text-[10px] font-bold uppercase text-zinc-500 mb-1" %>
          <%= f.number_field :max_price, value: params[:max_price], placeholder: "10000", class: "w-full border-2 border-zinc-200 p-2 text-xs" %>
        </div>
        <%= f.submit "Застосувати", class: "w-full bg-zinc-900 text-white text-xs font-bold uppercase py-2 cursor-pointer" %>
      <% end %>
    </aside>

    <div class="md:col-span-3 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <% @products.each do |product| %>
        <div class="bg-white border-2 border-zinc-200 p-4 flex flex-col justify-between">
          <div>
            <div class="h-32 bg-zinc-100 border border-zinc-200 flex items-center justify-center font-mono-num text-[10px] text-zinc-400 mb-3">
              [ <%= product.category.name %> ]
            </div>
            <div class="text-[10px] text-zinc-400 font-mono-num">SKU: <%= product.sku %></div>
            <h3 class="text-sm font-bold text-zinc-900 mt-1"><%= product.name %></h3>
          </div>
          <div class="pt-4 border-t border-zinc-100 mt-4 space-y-2">
            <div class="text-lg font-black font-mono-num text-zinc-900">
              <%= number_to_currency(product.price, unit: "грн", format: "%n %u") %>
            </div>
            <%= button_to "У кошик", cart_items_path(product_id: product.id), method: :post, class: "w-full bg-amber-600 hover:bg-amber-500 text-white text-xs font-bold uppercase py-2 text-center" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>